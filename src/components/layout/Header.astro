---
import Brand from '../ui/Brand.astro';
import Icon from '../ui/Icon.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import { navigation } from '../../data/site';
---

<header class="site-header relative z-30 border-b border-line bg-light">
  <div class="page-width flex min-h-24 items-center justify-between gap-5 py-3 lg:min-h-28">
    <Brand symbolOnly />
    <nav class="hidden items-center gap-6 lg:flex xl:gap-9" aria-label="Navegación principal">
      {navigation.map((item) => (
        <a class="py-3 text-base font-medium underline-offset-8 hover:underline" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="hidden lg:block">
      <WhatsAppLink label="Hablemos" variant="outline" />
    </div>
    <details class="mobile-menu group lg:hidden">
      <summary
        class="flex min-h-12 cursor-pointer list-none items-center gap-3 px-2 text-base"
        aria-label="Abrir menú de navegación"
      >
        <span>Menú</span>
        <Icon name="menu" class="group-open:hidden" />
        <Icon name="close" class="hidden group-open:block" />
      </summary>
      <nav
        class="absolute inset-x-0 top-full border-b border-line bg-light px-5 pt-4 pb-8 shadow-xl md:px-12"
        aria-label="Navegación móvil"
      >
        {navigation.map((item, index) => (
          <a class="flex items-center gap-4 border-b border-line py-4 text-xl" href={item.href}>
            <span class="text-base text-muted">0{index + 1}</span>
            {item.label}
            <Icon name="arrow-up" class="ml-auto text-deep-green" />
          </a>
        ))}
        <div class="mt-6">
          <WhatsAppLink label="Hablar por WhatsApp" variant="dark" />
        </div>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const summary = menu?.querySelector('summary');
  const close = () => {
    if (menu) menu.open = false;
  };
  menu?.addEventListener('toggle', () =>
    summary?.setAttribute(
      'aria-label',
      menu.open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación',
    ),
  );
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      close();
      summary?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !menu?.contains(event.target)) close();
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) close();
  });
</script>
