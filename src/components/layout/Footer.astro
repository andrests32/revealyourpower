---
import { Image } from 'astro:assets';
import theraprohealth from '../../assets/images/theraprohealth-original.png';
import Brand from '../ui/Brand.astro';
import Icon from '../ui/Icon.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import { navigation } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-light pt-16 pb-8">
  <div class="page-width">
    <div class="grid gap-10 pb-12 md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_0.8fr]" data-reveal>
      <div>
        <Brand />
        <p class="mt-6 text-lg leading-relaxed text-muted">
          Nuevas perspectivas.
          <br />
          Conversaciones con sentido.
        </p>
        <div class="mt-3">
          <WhatsAppLink label="Contactar por WhatsApp" variant="text" />
        </div>
      </div>
      <nav
        class="grid grid-cols-2 content-start gap-x-6 gap-y-4 pt-3"
        aria-label="Navegación del pie de página"
      >
        {navigation.map((item) => (
          <a
            class="inline-flex min-h-11 items-center text-base underline-offset-4 hover:underline"
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="flex flex-col items-start gap-4 lg:items-center">
        <span class="text-base tracking-[0.06em] text-muted">UNA METODOLOGÍA DE</span>
        <Image
          src={theraprohealth}
          alt="Theraprohealth"
          width={400}
          format="webp"
          loading="lazy"
          class="h-auto w-48 mix-blend-multiply"
        />
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-base text-muted">
      <span>© {year} Reveal Your Power.</span>
      <span>Herramienta y formación para acompañar.</span>
      <a href="#inicio" class="inline-flex min-h-12 items-center gap-2 text-dark">
        Volver al inicio
        <Icon name="arrow-up" />
      </a>
    </div>
  </div>
</footer>
