---
import SectionLabel from '../ui/SectionLabel.astro';
import Icon from '../ui/Icon.astro';
import { perspectives } from '../../data/content';
const icons = ['images', 'idea', 'question'] as const;
---

<section id="metodologia" class="section-space bg-[#edf4ef]" aria-labelledby="methodology-title">
  <div class="page-width">
    <SectionLabel number="01" label="LA METODOLOGÍA" />
    <div class="mt-9 grid items-end gap-8 lg:mt-11 lg:grid-cols-[1.25fr_1fr] lg:gap-16" data-reveal>
      <h2 id="methodology-title" class="display-title">
        Una herramienta.
        <br />
        <em>Nuevas perspectivas.</em>
      </h2>
      <div class="max-w-md lg:justify-self-end">
        <p class="text-body text-muted">
          Reveal Your Power integra cartas visuales, conceptos y preguntas para enriquecer procesos
          de exploración y acompañamiento.
        </p>
        <span class="tiny-label mt-6 block">EL VALOR ESTÁ EN LA CONVERSACIÓN.</span>
      </div>
    </div>
    <div class="mt-12 grid gap-8 md:mt-16 md:grid-cols-3 md:gap-0" data-stagger>
      {perspectives.map((item, index) => (
        <div
          class="border-t border-deep-green/30 pt-6 md:pr-6 md:not-first:border-l md:not-first:border-l-deep-green/20 md:not-first:pl-6 lg:pr-9 lg:not-first:pl-9"
          data-stagger-item
        >
          <div class="flex items-center justify-between text-deep-green">
            <span class="text-base">{item.number}</span>
            <Icon name={icons[index]} size={32} />
          </div>
          <h3 class="mt-6 font-editorial text-4xl font-normal lg:text-5xl">{item.title}</h3>
          <p class="mt-3 text-body text-muted">{item.description}</p>
          <span class="mt-7 block h-px w-9 bg-deep-green" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>
</section>
