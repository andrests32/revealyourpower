---
import CardOrbit from '../cards/CardOrbit.astro';
import Icon from '../ui/Icon.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import { hero } from '../../data/content';
---

<section class="hero relative overflow-clip bg-light" id="inicio" aria-labelledby="hero-title">
  <div class="hero-stage relative flex flex-col xl:min-h-[820px]">
    <CardOrbit />
    <div class="hero-copy page-width relative z-2 pt-14 text-center md:pt-20 xl:max-w-240">
      <p class="eyebrow hero-reveal flex items-center justify-center gap-3">
        <span class="status-dot"></span>
        {hero.eyebrow}
      </p>
      <h1
        id="hero-title"
        class="mx-auto mt-8 max-w-240 font-editorial text-[clamp(3rem,7.3vw,6.25rem)] leading-[1.03] font-normal tracking-[-0.045em]"
      >
        <span class="hero-line block overflow-hidden px-1 pb-2">
          <span class="hero-type inline-block">Amplía tus herramientas.</span>
        </span>
        <span class="hero-line block overflow-hidden px-1 pb-2">
          <em class="hero-type inline-block text-deep-green">Descubre nuevas</em>
        </span>
        <span class="hero-line block overflow-hidden px-1 pb-2">
          <em class="hero-type inline-block text-deep-green">perspectivas.</em>
        </span>
      </h1>
      <p class="hero-description hero-reveal mx-auto mt-6 max-w-[540px] text-lg leading-relaxed text-muted sm:text-xl">
        {hero.description}
      </p>
      <div class="hero-actions hero-reveal mt-8 flex flex-col items-center gap-2 [&_.contact-action]:items-center">
        <a href="#metodologia" class="button button--dark">
          <span>Descubre Reveal Your Power</span>
          <Icon name="arrow-up" />
        </a>
        <WhatsAppLink label="Solicitar información" variant="text" showNote />
      </div>
    </div>
  </div>
  <div class="hero-bottom page-width flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-base lg:min-h-28">
    <a href="#metodologia" class="group inline-flex min-h-12 items-center gap-3">
      <span class="grid size-11 place-items-center rounded-full border border-line group-hover:bg-soft-mint">
        <Icon name="down" />
      </span>
      <span>Desliza para descubrir</span>
    </a>
    <p class="flex items-center gap-3">
      <span>Herramienta física</span>
      <Icon name="plus" size={18} />
      <span>Formación</span>
    </p>
    <button
      class="motion-control flex min-h-12 cursor-pointer items-center gap-2 text-muted"
      type="button"
      aria-pressed="false"
      hidden
    >
      <span data-motion-pause>
        <Icon name="pause" />
      </span>
      <span data-motion-play hidden>
        <Icon name="play" />
      </span>
      <span data-motion-label>Pausar movimiento</span>
    </button>
  </div>
</section>
