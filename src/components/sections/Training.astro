---
import { Image } from 'astro:assets';
import symbol from '../../assets/images/only-logo.png';
import SectionLabel from '../ui/SectionLabel.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import Icon from '../ui/Icon.astro';
import { upcomingModules } from '../../data/content';
---

<section
  id="formacion"
  class="training section-space bg-dark text-light [--color-line:#d9efe838] [--color-muted:#b8ccc2] [&_.display-title_em]:text-primary"
  aria-labelledby="training-title"
>
  <div class="page-width">
    <SectionLabel number="05" label="LA FORMACIÓN" light />
    <div
      class="mt-9 flex flex-col gap-6 lg:mt-11 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
      data-reveal
    >
      <h2 id="training-title" class="display-title">
        Tu formación
        <br />
        <em>comienza aquí.</em>
      </h2>
      <p class="max-w-md text-body text-muted">
        La herramienta es el inicio.
        <br />
        La formación te acompaña a descubrir cómo utilizar la metodología.
      </p>
    </div>
    <div
      class="training-route mt-12 mb-8 flex max-w-lg items-center gap-3"
      aria-label="Ruta de cuatro módulos"
    >
      <span class="grid size-11 shrink-0 place-items-center rounded-full border border-primary bg-primary text-base text-dark">
        01
      </span>
      {[2, 3, 4].map((number) => (
        <>
          <span class="route-line h-px w-full origin-left bg-line" aria-hidden="true"></span>
          <span class="grid size-11 shrink-0 place-items-center rounded-full border border-line text-base text-muted">
            0{number}
          </span>
        </>
      ))}
    </div>
    <article
      class="practitioner relative grid gap-10 overflow-hidden rounded-lg border border-primary/30 bg-[#162925] px-5 py-10 sm:p-10 lg:grid-cols-[1.2fr_1fr] lg:p-14"
      data-reveal
    >
      <div class="relative z-1 flex flex-col items-start justify-center">
        <p class="eyebrow flex items-center gap-3 text-primary">
          <span class="status-dot bg-primary"></span>MÓDULO 01 · TU PRIMER PASO
        </p>
        <h3 class="mt-5 font-editorial text-[clamp(3.25rem,6vw,5.25rem)] leading-tight font-normal tracking-tight">
          Practitioner
        </h3>
        <p class="mt-5 mb-8 max-w-md text-body text-muted">
          El primer módulo de la ruta de formación para aprender a utilizar Reveal Your Power.
        </p>
        <WhatsAppLink
          label="Solicitar información sobre Practitioner"
          interest="practitioner"
          variant="mint"
        />
      </div>
      <div
        class="relative flex min-h-[400px] items-center justify-center pb-10 perspective-[1000px]"
        aria-hidden="true"
      >
        <div class="book-orbit absolute size-80 rounded-full border border-primary/15 sm:size-[380px]">
          <div class="absolute inset-7 rounded-full border border-primary/10"></div>
        </div>
        <div class="book relative aspect-[12/17] w-[min(15rem,85%)] -rotate-6 -rotate-y-18 rotate-x-6 shadow-[24px_22px_35px_#00000030]">
          <div class="absolute inset-0 grid grid-rows-[auto_1fr_auto] gap-3 rounded-xs border-l-[6px] border-[#064931] bg-[#086441] px-3 py-5 text-center text-[#f4f5d9]">
            <span class="text-base leading-snug tracking-[0.06em]">REVEAL YOUR POWER</span>
            <div class="flex min-h-0 items-center justify-center">
              <Image
                src={symbol}
                alt=""
                width={400}
                format="webp"
                loading="lazy"
                class="h-full max-h-28 w-full object-contain"
              />
            </div>
            <div class="flex flex-col items-center">
              <span class="text-base tracking-[0.02em]">THERAPROHEALTH</span>
              <span class="mt-4 font-editorial text-3xl leading-none">Practitioner</span>
              <span class="mt-3 h-px w-12 bg-[#f4f5d9]"></span>
            </div>
          </div>
        </div>
        <span class="absolute bottom-0 text-base tracking-[0.04em] text-muted">
          HERRAMIENTA + FORMACIÓN
        </span>
      </div>
    </article>
    <div class="grid border-b border-line lg:grid-cols-3" data-stagger>
      {upcomingModules.map((number) => (
        <div
          class="flex items-center gap-6 border-b border-line py-8 last:border-b-0 lg:border-b-0 lg:not-first:border-l lg:not-first:pl-7 lg:not-last:pr-7"
          data-stagger-item
        >
          <span class="font-editorial text-5xl leading-none text-[#a4bcb0]">{number}</span>
          <div>
            <h3 class="text-lg font-medium">Módulo {number}</h3>
            <p class="mt-1 text-base text-muted">Próximamente</p>
          </div>
          <Icon name="minus" class="ml-auto text-muted" />
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
      <p class="text-body text-muted">
        Una ruta de cuatro módulos.
        <br />
        Más perspectivas, paso a paso.
      </p>
      <WhatsAppLink label="Consultar la formación" interest="training" variant="text" />
    </div>
    <p class="mt-10 text-base leading-relaxed text-muted">
      Esta formación no habilita para ejercer psicología, psicoterapia ni realizar diagnósticos
      clínicos.
    </p>
  </div>
</section>
<style>
  /* Textura del canto del libro: el único efecto de superficie fuera de Tailwind. */
  .book::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 2px;
    width: 13px;
    height: calc(100% - 4px);
    background: repeating-linear-gradient(90deg, #d8ded4 0 1px, #acb7ac 1px 2px);
    transform-origin: left;
    transform: rotateY(50deg);
  }
</style>
