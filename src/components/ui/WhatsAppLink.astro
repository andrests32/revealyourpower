---
import Icon from './Icon.astro';
import { getWhatsAppUrl, type ContactInterest } from '../../lib/whatsapp';
interface Props {
  interest?: ContactInterest;
  label: string;
  variant?: 'dark' | 'mint' | 'outline' | 'text';
  compact?: boolean;
  showNote?: boolean;
}
const { interest = 'general', label, variant = 'dark', showNote = false } = Astro.props;
const url = getWhatsAppUrl(interest);
---

<div class="contact-action inline-flex max-w-full flex-col items-start gap-3">
  {url ? (
    <a
      class:list={['button', `button--${variant}`]}
      href={url}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>{label}</span>
      <Icon name="whatsapp" />
      <span class="sr-only"> (abre WhatsApp en otra pestaña)</span>
    </a>
  ) : (
    <button class:list={['button', `button--${variant}`]} type="button" disabled>
      <span>{label}</span>
      <Icon name="whatsapp" />
    </button>
  )}
  {!url && showNote && (
    <span class="text-base leading-relaxed text-muted">
      WhatsApp no está disponible en este momento.
    </span>
  )}
</div>
