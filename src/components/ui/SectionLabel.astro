---
interface Props {
  number: string;
  label: string;
  light?: boolean;
}
const { number, label, light = false } = Astro.props;
---

<p
  class:list={[
    'inline-flex items-center gap-3 text-base leading-relaxed font-medium tracking-[0.06em]',
    light && 'text-primary',
  ]}
>
  <span class="grid size-10 shrink-0 place-items-center rounded-full border border-line tracking-normal">
    {number}
  </span>
  <span>{label}</span>
</p>
